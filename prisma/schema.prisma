generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id            String    @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified DateTime?
  pwHash        String
  image         String?
  role          String    @default("user") // "user" | "moderator" | "admin"
  accounts      Account[]
  sessions      Session[]

  // Поля для ученика
  grade         Int?      // класс (8, 9, 10, 11)
  phone         String?
  parentName    String?   // имя родителя (для несовершеннолетних)
  parentPhone   String?
  goals         String?   @db.Text // цели обучения
  
  // Связи
  studentLessons Lesson[] @relation("StudentLessons")
  tutorLessons   Lesson[] @relation("TutorLessons")
  homeworks     Homework[]
  progress      Progress[]
  messages      Message[]
  consents Consent[]
  testResults TestResult[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
   @@map("users")
}

// Модель урока
model Lesson {
  id            String    @id @default(cuid())
  topic         String?
  subject       String    @default("Химия") 
  startTime     DateTime
  endTime       DateTime?
  meetingLink   String?   @db.Text
  format        String    @default("online") 
  status        String    @default("scheduled")
  notes         String?   @db.Text
  homework      Homework? 
  
  // Связь с учеником
  userId        String
  user          User      @relation("StudentLessons", fields: [userId], references: [id], onDelete: Cascade)
  
  // Связь с репетитором
  tutorId       String?
  tutor         User?     @relation("TutorLessons", fields: [tutorId], references: [id])
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("lessons")
}


// Модель домашнего задания
model Homework {
  id            String    @id @default(cuid())
  title         String
  topic         String?
  description   String?   @db.Text
  dueDate       DateTime
  status        String    @default("assigned") // "assigned", "in_progress", "submitted", "completed", "returned"
  grade         Int?      // оценка (1-10 или баллы ЕГЭ)
  feedback      String?   @db.Text // комментарий репетитора
  fileUrl       String?   @db.Text // ссылка на файл задания
  studentFile   String?   @db.Text // ссылка на файл решения ученика
  
  // Связь с учеником
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 🔹 Обратная связь (обязательна!)
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  lessonId    String   @unique  // ← @unique делает связь One-to-One

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("homeworks")
}

// Модель прогресса по темам
model Progress {
  id            String    @id @default(cuid())
  topic         String    // тема (например, "Органическая химия")
  subtopic      String?   // подтема (например, "Спирты")
  score         Int       // результат (0-100)
  testDate      DateTime?
  
  // Связь с учеником
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("progress")
}

// Модель сообщений (чат с репетитором)
model Message {
  id            String    @id @default(cuid())
  content       String    @db.Text
  isRead        Boolean   @default(false)
  senderRole    String    // "user" или "tutor"
  
  // Связь с учеником
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("messages")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Review {
  id          String   @id @default(cuid())
  authorName  String
  authorEmail String
  avatar      String?
  content     String   @db.Text
  rating      Int
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())

  @@map("reviews") 
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  rubric        String
  dayNumber     String
  
  // 🔹 Контент: HTML (сконвертированный из DOCX)
  contentHtml   String    @db.Text
  excerpt       String?   @db.Text
  
  // 🔹 Пути к файлам
  sourcePath    String    @unique // Путь к исходному DOCX
  imagePath     String?           // Путь к изображению
  
  googleDriveLink String?
  publishedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  tags          String[]
  views         Int       @default(0)
  
  @@index([rubric])
  @@index([dayNumber])
  @@index([publishedAt])
  @@map("blog_posts")
}

// 🔹 Добавляем enum
enum ConsentType {
  registration
  contact
  newsletter
  lesson_booking
}

model Consent {
  id              String      @id @default(cuid())
  
  userId          String?
  email           String?
  
  policyVersion   String      @default("1.0")
  consentType     ConsentType // 🔹 Было String, стало ConsentType
  ipAddress       String?     @db.VarChar(45)
  userAgent       String?     @db.Text
  consentDate     DateTime    @default(now())
  
  isActive        Boolean     @default(true)
  revokedAt       DateTime?
  
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([email])
  @@index([consentType])
  @@map("consents")
}

model TestQuestion {
  id            String   @id @default(cuid())
  question      String   // Текст вопроса
  option1       String   // Вариант 1
  option2       String   // Вариант 2
  option3       String   // Вариант 3
  option4       String   // Вариант 4
  correctOption Int      // Номер правильного ответа (1-4)
  explanation   String?  // Пояснение правильного ответа
  category      String?  // Категория (органика, неорганика и т.д.)
  difficulty    Int      @default(1) // Сложность 1-3
  order         Int      @default(0) // Порядок вывода
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TestResult {
  id            String   @id @default(cuid())
  studentName   String
  studentEmail  String?
  score         Int      // Набранные баллы
  totalQuestions Int     // Всего вопросов
  percentage    Float    // Процент правильных
  answers       Json     // Детальные ответы
  completedAt   DateTime @default(now())
  userId        String?  // Если ученик зарегистрирован
  user          User?    @relation(fields: [userId], references: [id])
}